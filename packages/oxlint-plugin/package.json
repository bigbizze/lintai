{
	"name": "@lintai/oxlint-plugin",
	"version": "0.6.1",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bigbizze/lintai.git",
		"directory": "packages/oxlint-plugin"
	},
	"homepage": "https://github.com/bigbizze/lintai#readme",
	"bugs": {
		"url": "https://github.com/bigbizze/lintai/issues"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "node --test 'dist/**/*.test.js'"
	},
	"dependencies": {
		"@lintai/authoring-rules": "workspace:*",
		"@lintai/client": "workspace:*"
	},
	"peerDependencies": {
		"oxlint": "^1.90.0"
	},
	"devDependencies": {
		"eslint": "^9.24.0",
		"oxlint": "1.90.0",
		"typescript": "^5.7.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
